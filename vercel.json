{
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demostracion",
      "destination": "/demo",
      "permanent": true
    },
    {
      "source": "/servicios",
      "destination": "/soluciones",
      "permanent": true
    },
    {
      "source": "/proximamente",
      "destination": "/coming-soon",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/:path(soluciones|productos|planes|demo|como-trabajamos|nosotros|contacto|gracias|coming-soon|crm|ia|herramientas|comunidad|dashboard|recursos|aviso-de-privacidad|terminos-y-condiciones|politica-de-cookies|productos/pos-cafeteria|productos/ecommerce|productos/delivery|productos/crm|productos/gimnasios|servicios/desarrollo-web|servicios/sistemas-a-medida|servicios/automatizacion)",
      "destination": "/index.html"
    }
  ]
}
